# Both spellings on purpose. `node_modules/` matches a directory and NOT a
# symlink to one — which is how an absolute symlink into somebody's home
# directory reached a commit here, from a worktree that borrowed the install.
node_modules
node_modules/
dist/
tsconfig.tsbuildinfo
tsconfig.build.tsbuildinfo
*.log
.DS_Store
.env
.env.local
.codex

