{
    // Restricts spell checking to files inside the project only
    "cSpell.files": [
      "**/*"
    ],
    "cSpell.ignorePaths": [
      // Ignore everything outside the project's root folder
      "!**"
    ],
    "cSpell.words": [
      "dataelement",
      "DDLS",
      "DEVC",
      "doma",
      "dtel",
      "ECONNREFUSED",
      "ECONNRESET",
      "EHOSTUNREACH",
      "ENETUNREACH",
      "ENOTFOUND",
      "ETIMEDOUT",
      "fugr",
      "functiongroup",
      "functionmodule",
      "intf",
      "PKCE",
      "relogin",
      "STRU",
      "Subpackages",
      "tabletype",
      "Validatable",
      "Versionable",
      "ZTEST"
    ]
}